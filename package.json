{
  "name": "gitea-ui-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "pretest": "node -e \"require('fs').rmSync('allure-results', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:chrome": "vitest run --project=chrome",
    "test:firefox": "vitest run --project=firefox",
    "test:edge": "vitest run --project=edge",
    "test:serial": "vitest run --no-file-parallelism",
    "report": "allure generate ./allure-results",
    "report:open": "allure open ./allure-report/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "description": "",
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "got": "^16.0.0",
    "selenium-webdriver": "^4.48.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/selenium-webdriver": "^4.35.6",
    "@vitest/runner": "^4.1.11",
    "allure": "^3.16.0",
    "allure-vitest": "^3.11.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
