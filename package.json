{
  "name": "gitea-ui-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "business-logic",
    "services/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "npm test -w @gitea-automation/gitea-selenium-vitest",
    "test:chrome": "npm run test:chrome -w @gitea-automation/gitea-selenium-vitest",
    "test:firefox": "npm run test:firefox -w @gitea-automation/gitea-selenium-vitest",
    "test:edge": "npm run test:edge -w @gitea-automation/gitea-selenium-vitest",
    "test:parallel": "npm run test:parallel -w @gitea-automation/gitea-selenium-vitest",
    "test:serial": "npm run test:serial -w @gitea-automation/gitea-selenium-vitest",
    "test:browserstack": "npm run test:browserstack -w @gitea-automation/gitea-selenium-vitest",
    "test:cucumber": "npm test -w @gitea-automation/gitea-selenium-cucumber",
    "test:cucumber:parallel": "npm run test:parallel -w @gitea-automation/gitea-selenium-cucumber",
    "report": "npm run report -w @gitea-automation/gitea-selenium-vitest",
    "report:open": "npm run report:open -w @gitea-automation/gitea-selenium-vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
