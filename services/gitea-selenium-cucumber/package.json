{
  "name": "@gitea-automation/gitea-selenium-cucumber",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "node -e \"require('fs').rmSync('allure-results', { recursive: true, force: true })\"",
    "test": "npm run test:parallel",
    "test:chrome": "cross-env BROWSER=chrome NODE_OPTIONS=--import=tsx cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox NODE_OPTIONS=--import=tsx cucumber-js",
    "test:edge": "cross-env BROWSER=edge NODE_OPTIONS=--import=tsx cucumber-js",
    "test:parallel": "concurrently -n chrome,firefox,edge -c blue,yellow,cyan \"npm:test:chrome\" \"npm:test:firefox\" \"npm:test:edge\"",
    "test:tag:parallel": "(npm run test:parallel) & (npm run report && npm run report:open)",
    "test:all:parallel": "(cross-env CUCUMBER_TAGS= npm run test:parallel) & (npm run report && npm run report:open)",
    "report": "allure generate ./allure-results",
    "report:open": "allure open ./allure-report/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gitea-automation/business-logic": "*",
    "@gitea-automation/core-data-handler": "*",
    "@gitea-automation/core-page-objects": "*",
    "@gitea-automation/core-selenium": "*",
    "dotenv": "^17.4.2",
    "selenium-webdriver": "^4.48.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@types/selenium-webdriver": "^4.35.6",
    "allure": "^3.16.0",
    "allure-cucumberjs": "^3.12.1",
    "allure-js-commons": "3.12.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "vitest": "^4.1.11"
  }
}
