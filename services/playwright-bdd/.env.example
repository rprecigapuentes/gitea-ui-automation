GITEA_BASE_URL=http://localhost:3000

GITEA_OWNER_CHROME=chrome-owner
GITEA_OWNER_CHROME_PASSWORD=change-me
GITEA_OWNER_FIREFOX=firefox-owner
GITEA_OWNER_FIREFOX_PASSWORD=change-me
GITEA_OWNER_EDGE=edge-owner
GITEA_OWNER_EDGE_PASSWORD=change-me

# Read by the `clients` fixture, one per browser, so a scenario seeds its own state through the API
# as the owner that runs it.
GITEA_TOKEN_CHROME=change-me
GITEA_TOKEN_FIREFOX=change-me
GITEA_TOKEN_EDGE=change-me

# The second account of each browser, for a scenario that needs a user who is not the owner.
GITEA_INV_CHROME=chrome-invited
GITEA_INV_CHROME_PASSWORD=change-me
GITEA_INV_FIREFOX=firefox-invited
GITEA_INV_FIREFOX_PASSWORD=change-me
GITEA_INV_EDGE=edge-invited
GITEA_INV_EDGE_PASSWORD=change-me

# One token for every browser: only the users it creates have to be browser-unique.
GITEA_ADMIN_TOKEN=change-me
