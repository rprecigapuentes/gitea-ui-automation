# Gitea (app bajo test)
GITEA_BASE_URL=http://localhost:3000

# Multi-cuenta / multi-browser: lo que realmente usan los fixtures (session-credentials.util.ts)
# y lo que registra/mintea el pipeline CT (.gitea/workflows/ct.yml).
GITEA_OWNER_CHROME=chrome-owner
GITEA_OWNER_CHROME_PASSWORD=change-me
GITEA_OWNER_FIREFOX=firefox-owner
GITEA_OWNER_FIREFOX_PASSWORD=change-me
GITEA_OWNER_EDGE=edge-owner
GITEA_OWNER_EDGE_PASSWORD=change-me

GITEA_INV_CHROME=inv-chrome
GITEA_INV_CHROME_PASSWORD=change-me
GITEA_INV_FIREFOX=inv-firefox
GITEA_INV_FIREFOX_PASSWORD=change-me
GITEA_INV_EDGE=inv-edge
GITEA_INV_EDGE_PASSWORD=change-me

GITEA_TOKEN_CHROME=
GITEA_TOKEN_FIREFOX=
GITEA_TOKEN_EDGE=

# BrowserStack
BROWSERSTACK_USERNAME=your-browserstack-username
BROWSERSTACK_ACCESS_KEY=your-browserstack-access-key
BROWSERSTACK_LOCAL_IDENTIFIER=gitea-ui-local
