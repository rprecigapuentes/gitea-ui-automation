# Dependencies
node_modules/
.env

# Reports
reports/
allure-results/
allure-report/
local.log

# Claude Code
# Contents, not the directory itself: git will not descend into an excluded
# directory, so `.claude/` would make the negation below unreachable.
.claude/*
# The Playwright agent definitions are a deliverable, not local configuration:
# they are what teaches an agent this framework's architecture, so they ship.
!.claude/agents/
